#!/bin/bash
set -euo pipefail

source $(dirname $0)/version

ARCH=${ARCH:-"amd64"}

cd $(dirname $0)/..

if echo "$VERSION" | grep -q dirty; then
    echo "Refusing to package a dirty version: $VERSION" >&2
    exit 1
fi

version=${VERSION#v}
artifact="dist/artifacts/mount-propagation-${version}-linux-${ARCH}.tar.gz"
mkdir -p dist/artifacts
rm -f "$artifact"

tar \
    --sort=name \
    --mtime="@${SOURCE_DATE_EPOCH:-0}" \
    --owner=0 \
    --group=0 \
    --numeric-owner \
    -C bin \
    -cf - \
    mount-propagation share-mnt |
    gzip -n -9 > "$artifact"

echo "Created $artifact with the share-mnt compatibility alias"
